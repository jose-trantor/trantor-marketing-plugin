{
 "description": "Campañas con inversión en el periodo anterior de la misma duración.",
 "source": {
  "args": {
   "account_ids": "__LV_META_ACCOUNT_IDS__",
   "date_from": "{{desde_prev}}",
   "date_to": "{{hasta_prev}}",
   "fields": [
    "account_name",
    "campaign_name",
    "objective",
    "spend",
    "impressions",
    "reach",
    "frequency",
    "inline_link_clicks",
    "actions",
    "action_values"
   ],
   "level": "campaign",
   "time_increment": "all_days"
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "meta_insights"
 },
 "title": "Meta: campañas, periodo anterior"
}