{
 "description": "Las mismas métricas diarias en el periodo anterior de la misma duración.",
 "source": {
  "args": {
   "page_id": "__LV_PAGE_ID__",
   "date_from": "{{desde_prev}}",
   "date_to": "{{hasta_prev}}",
   "granularity": "day",
   "metrics": [
    "page_media_view",
    "page_post_engagements",
    "page_views_total",
    "page_video_views",
    "page_daily_follows",
    "page_daily_unfollows"
   ]
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "page_insights"
 },
 "title": "Facebook: página, anterior"
}