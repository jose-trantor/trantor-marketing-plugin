{
 "description": "Nuevos seguidores por día en los últimos 30 días (Instagram no da más historia).",
 "source": {
  "args": {
   "ig_id": "__LV_IG_ID__",
   "date_from": "{{desde_30d}}",
   "date_to": "{{hasta}}",
   "granularity": "day",
   "metrics": [
    "follower_count"
   ]
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde_30d": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "instagram_insights"
 },
 "title": "Instagram: nuevos seguidores"
}