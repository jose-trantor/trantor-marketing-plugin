{
 "description": "Inversión, impresiones y clics de cada anuncio en el periodo anterior.",
 "source": {
  "args": {
   "account_ids": "__LV_META_ACCOUNT_IDS__",
   "date_from": "{{desde_prev}}",
   "date_to": "{{hasta_prev}}",
   "fields": [
    "account_name",
    "ad_name",
    "spend",
    "impressions",
    "inline_link_clicks"
   ],
   "level": "ad",
   "time_increment": "all_days"
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "meta_insights"
 },
 "title": "Meta: anuncios, periodo anterior"
}