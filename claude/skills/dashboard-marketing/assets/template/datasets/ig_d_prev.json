{
 "description": "Las mismas métricas diarias en el periodo anterior de la misma duración.",
 "source": {
  "args": {
   "ig_id": "__LV_IG_ID__",
   "date_from": "{{desde_prev}}",
   "date_to": "{{hasta_prev}}",
   "granularity": "day",
   "metrics": [
    "reach",
    "views",
    "total_interactions",
    "likes",
    "comments",
    "shares",
    "saves"
   ]
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "instagram_insights"
 },
 "title": "Instagram: cuenta, anterior"
}