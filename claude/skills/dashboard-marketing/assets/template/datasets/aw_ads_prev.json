{
 "description": "Impresiones y reproducciones de cada anuncio de awareness en el periodo anterior.",
 "source": {
  "args": {
   "account_ids": "__LV_META_ACCOUNT_IDS__",
   "date_from": "{{desde_prev}}",
   "date_to": "{{hasta_prev}}",
   "fields": [
    "account_name",
    "ad_name",
    "spend",
    "impressions",
    "actions"
   ],
   "filters": [
    {
     "field": "campaign.objective",
     "operator": "IN",
     "value": [
      "OUTCOME_AWARENESS",
      "OUTCOME_ENGAGEMENT",
      "REACH",
      "BRAND_AWARENESS",
      "VIDEO_VIEWS",
      "POST_ENGAGEMENT"
     ]
    }
   ],
   "level": "ad",
   "time_increment": "all_days"
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "meta_insights"
 },
 "title": "Awareness: anuncios, anterior"
}