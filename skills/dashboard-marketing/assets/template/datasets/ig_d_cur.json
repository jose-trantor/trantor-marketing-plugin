{
 "description": "Alcance (seguidores y no seguidores), visualizaciones e interacciones diarias de @lavasca.co en el periodo.",
 "source": {
  "args": {
   "ig_id": "__LV_IG_ID__",
   "date_from": "{{desde}}",
   "date_to": "{{hasta}}",
   "granularity": "day",
   "metrics": [
    "reach",
    "views",
    "total_interactions",
    "likes",
    "comments",
    "shares",
    "saves"
   ]
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "instagram_insights"
 },
 "title": "Instagram: cuenta por día"
}