{
 "description": "Visualizaciones pagadas y orgánicas, interacciones, seguidores y visitas diarias de la página __LV_PAGE_NAME__ en el periodo.",
 "source": {
  "args": {
   "page_id": "__LV_PAGE_ID__",
   "date_from": "{{desde}}",
   "date_to": "{{hasta}}",
   "granularity": "day",
   "metrics": [
    "page_media_view",
    "page_post_engagements",
    "page_views_total",
    "page_video_views",
    "page_daily_follows",
    "page_daily_unfollows"
   ]
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "page_insights"
 },
 "title": "Facebook: página por día"
}