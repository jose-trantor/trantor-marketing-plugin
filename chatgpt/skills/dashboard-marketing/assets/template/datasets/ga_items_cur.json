{
 "description": "Vistas, añadidos al carrito, unidades vendidas e ingresos de cada producto.",
 "source": {
  "args": {
   "date_from": "{{desde}}",
   "date_to": "{{hasta}}",
   "dimensions": [
    "itemName"
   ],
   "metrics": [
    "itemsViewed",
    "itemsAddedToCart",
    "itemsPurchased",
    "itemRevenue"
   ],
   "property_id": "__LV_GA4_ID__"
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "ga4_report"
 },
 "title": "Web: productos"
}