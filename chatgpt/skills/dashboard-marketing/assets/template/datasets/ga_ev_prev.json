{
 "description": "Registros de cada evento en el periodo anterior.",
 "source": {
  "args": {
   "date_from": "{{desde_prev}}",
   "date_to": "{{hasta_prev}}",
   "dimensions": [
    "eventName"
   ],
   "metrics": [
    "eventCount"
   ],
   "property_id": "__LV_GA4_ID__"
  },
  "connector": "__LV_CONNECTOR__",
  "kind": "call",
  "rules": {
   "desde_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   },
   "hasta_prev": {
    "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"
   }
  },
  "tool": "ga4_report"
 },
 "title": "Web: eventos, anterior"
}